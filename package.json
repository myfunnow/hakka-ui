{
  "name": "hakka-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:all": "pnpm -r build",
    "bump": "bumpp -r --no-tag --no-push",
    "release": "pnpm build:all && pnpm publish -r --no-git-checks",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "pnpm lint:check && pnpm format:check",
    "lint:fix": "pnpm lint:check --fix && pnpm format:fix",
    "lint:check": "eslint --cache --cache-strategy content --cache-location ./.cache/eslint/.eslintcache packages .storybook",
    "format:check": "pnpm format:base --check",
    "format:fix": "pnpm format:base --write",
    "format:base": "oxfmt .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@myfunnow/web-core-config-format": "^3.0.1",
    "@myfunnow/web-core-config-lint": "^3.0.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-links": "10.6.1",
    "@storybook/vue3-vite": "10.6.1",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "bumpp": "^12.3.0",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.71.0",
    "storybook": "10.6.1",
    "storybook-dark-mode": "^5.0.0",
    "typescript": "catalog:",
    "vite": "^8.3.1",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.0.3",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  }
}
