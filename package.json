{
  "name": "hakka-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:all": "pnpm -r build",
    "bump": "bumpp -r --no-tag --no-push",
    "release": "pnpm build:all && pnpm publish -r --no-git-checks",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "pnpm lint:check && pnpm format:check",
    "lint:fix": "pnpm lint:check --fix && pnpm format:fix",
    "lint:check": "eslint --cache --cache-strategy content --cache-location ./.cache/eslint/.eslintcache packages internal .storybook",
    "format:check": "pnpm format:base --check",
    "format:fix": "pnpm format:base --write",
    "format:base": "oxfmt .",
    "storybook": "pnpm --filter @myfunnow/hakka-tokens build && storybook dev -p 6006",
    "build-storybook": "pnpm --filter @myfunnow/hakka-tokens build && storybook build"
  },
  "devDependencies": {
    "@myfunnow/web-core-config-format": "^3.2.0",
    "@myfunnow/web-core-config-lint": "^3.2.0",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-links": "10.6.6",
    "@storybook/vue3-vite": "10.6.6",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "bumpp": "^12.3.0",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.77.0",
    "storybook": "10.6.6",
    "storybook-dark-mode": "^5.0.0",
    "typescript": "catalog:",
    "unocss": "^66.12.0",
    "vite": "^8.3.6",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.1.0",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=22.23.5",
    "pnpm": ">=10.0.0"
  }
}
