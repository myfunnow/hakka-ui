{
  "name": "hakka-ui",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-s build:src build:types",
    "build:src": "vite build",
    "build:types": "vue-tsc --project tsconfig.build-types.json",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "prepare": "pnpm build",
    "lint": "eslint src/ --fix",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "format:check": "pnpm format:base --check",
    "format:fix": "pnpm format:base --write",
    "format:base": "oxfmt ."
  },
  "devDependencies": {
    "@myfunnow/web-core-config-format": "^3.0.1",
    "@myfunnow/web-core-config-lint": "^3.0.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-links": "10.6.1",
    "@storybook/vue3-vite": "10.6.1",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/ui": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "naive-ui": "^2.45.3",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.71.0",
    "sass": "^1.105.1",
    "storybook": "10.6.1",
    "storybook-dark-mode": "^5.0.0",
    "typescript": "^6.0.3",
    "unocss": "^66.10.5",
    "vite": "^8.3.1",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "naive-ui": "^2.37.3",
    "vue": "^3.4.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
