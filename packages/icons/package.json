{
  "name": "@myfunnow/hakka-icons",
  "version": "0.1.0",
  "description": "FunNow Group icons as Vue components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myfunnow/hakka-ui.git",
    "directory": "packages/icons"
  },
  "files": [
    "/dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "rimraf dist && tsdown",
    "generate": "node scripts/generateIcons.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-vue": "^8.0.0",
    "vite-svg-loader": "^5.1.3",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  }
}
