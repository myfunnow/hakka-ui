{
  "name": "@myfunnow/hakka-core",
  "version": "0.1.0",
  "description": "FunNow Group Vue components without a UI library dependency",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myfunnow/hakka-ui.git",
    "directory": "packages/core"
  },
  "files": [
    "/dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "hakka-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "rimraf dist && tsdown",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@myfunnow/hakka-icons": "workspace:*",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@myfunnow/hakka-config": "workspace:*",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:",
    "vuetify": "3.7.12"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
