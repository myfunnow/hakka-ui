{
  "name": "@myfunnow/hakka-shared",
  "version": "0.1.0",
  "description": "Types and helpers shared by the hakka-ui packages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myfunnow/hakka-ui.git",
    "directory": "packages/shared"
  },
  "files": [
    "/dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "hakka-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "rimraf dist && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@myfunnow/hakka-config": "workspace:*",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
