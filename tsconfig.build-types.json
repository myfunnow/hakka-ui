{
  "extends": "./tsconfig.json",
  "include": ["./src/**/*.ts", "./src/**/*.vue"],
  "exclude": ["./src/**/*.stories.ts", "./src/**/*.test.ts"],
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist/types",
    "rootDir": "./src",
    "types": ["vite/client", "naive-ui/volar"]
  }
}
